#!/usr/bin/env python3
"""Apply length-preserving Linux Voice Typing patches to a Granola runtime."""
import argparse
import json
from pathlib import Path
import shutil
import struct

PROJECT = Path(__file__).resolve().parent.parent


def patch_archive(data):
    result = bytearray(data)
    _, header_size, _, json_size = struct.unpack('<4I', data[:16])
    tree = json.loads(data[16:16 + json_size])
    base = 8 + header_size
    changes = []

    def walk(files, prefix=''):
        for name, node in files.items():
            filename = prefix + name
            if 'files' in node:
                walk(node['files'], filename + '/')
            elif filename.endswith('.js') and 'offset' in node and not node.get('unpacked'):
                start = base + int(node['offset'])
                original = data[start:start + node['size']]
                updated = original
                pairs = []
                if filename == 'dist-electron/main/index.js':
                    pairs.append((b'Ny(`dictation_utils.node`)', b'Ny(`dictation_utils.cjs`) '))
                if filename.startswith('dist-app/assets/'):
                    pairs.append((b'return e===`darwin`?`Fn`:`ControlRight`', b'return e===`win32`?`ControlRight`:`Fn` '))
                for old, new in pairs:
                    if len(old) != len(new):
                        raise ValueError('Patch changes ASAR byte offsets')
                    if old in updated:
                        updated = updated.replace(old, new)
                        changes.append(filename)
                    elif new in updated:
                        changes.append(filename + ' (already patched)')
                result[start:start + node['size']] = updated
    walk(tree['files'])
    if not any(x.startswith('dist-electron/main/index.js') for x in changes):
        raise ValueError('Native dictation loader pattern not found; refusing incompatible build')
    if not any(x.startswith('dist-app/assets/') for x in changes):
        raise ValueError('Fn default pattern not found; refusing incompatible build')
    return bytes(result), changes


def apply(runtime):
    resources = runtime / 'app/resources'
    archive = resources / 'app.asar'
    original = archive.read_bytes()
    patched, changes = patch_archive(original)
    # A pristine backup allows deterministic repatching without redistributing code.
    backup = resources / 'app.asar.before-voice-typing'
    if not backup.exists():
        shutil.copy2(archive, backup)
    native = resources / 'native'
    native.mkdir(exist_ok=True)
    shutil.copy2(PROJECT / 'src/dictation-linux.cjs', native / 'dictation_utils.cjs')
    tmp = archive.with_suffix('.asar.new')
    tmp.write_bytes(patched)
    tmp.replace(archive)
    print('Linux Voice Typing bridge installed:', ', '.join(changes))


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('runtime', type=Path)
    apply(parser.parse_args().runtime)
